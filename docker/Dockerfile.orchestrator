FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY proto/ proto/
COPY go/ go/
RUN CGO_ENABLED=0 go build -o /out/orchestrator ./go/orchestrator

FROM alpine:3.20
COPY --from=build /out/orchestrator /usr/local/bin/orchestrator
ENV ORCHESTRATOR_PORT=50051
EXPOSE 50051
CMD ["orchestrator"]
