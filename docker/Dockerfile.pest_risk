FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY proto/ proto/
COPY go/ go/
RUN CGO_ENABLED=0 go build -o /out/pest_risk ./go/agents/pest_risk

FROM alpine:3.20
COPY --from=build /out/pest_risk /usr/local/bin/pest_risk
ENV PEST_RISK_AGENT_PORT=50056
EXPOSE 50056
CMD ["pest_risk"]
