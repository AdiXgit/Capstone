FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY proto/ proto/
COPY go/ go/
RUN CGO_ENABLED=0 go build -o /out/weather ./go/agents/weather

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/weather /usr/local/bin/weather
ENV WEATHER_AGENT_PORT=50052
EXPOSE 50052
CMD ["weather"]
