FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/python/shared
WORKDIR /app
COPY python/requirements.txt python/requirements.txt
RUN pip install --no-cache-dir -r python/requirements.txt
COPY python/shared/ python/shared/
COPY streamlit_dashboard/ streamlit_dashboard/
EXPOSE 8501
CMD ["streamlit", "run", "streamlit_dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
